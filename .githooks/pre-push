#!/bin/sh
# =====================================================================
# TERRANEX ATLAS - Git Pre-Push Hook (Safety Guard)
# =====================================================================
# 목적: CEO 승인 전 main 브랜치 직접 push를 원천 차단하고
#       자동화 테스트 통과 여부를 검증한다.
# =====================================================================

current_branch=$(git symbolic-ref --short HEAD 2>/dev/null)

# 1. main 브랜치 직접 push 차단
if [ "$current_branch" = "main" ]; then
    echo "================================================================"
    echo "🚨 [PUSH REJECTED] main 브랜치로의 직접 push는 금지되어 있습니다!"
    echo "👉 개발 작업 브랜치(task/issue-* 또는 feature/*)를 사용하세요."
    echo "👉 main 병합은 GitHub PR을 통해 CEO 최종 승인 후 수행해야 합니다."
    echo "================================================================"
    exit 1
fi

echo "🛡️ [Pre-Push Guard] 브랜치 체크 통과: '$current_branch'"

# 2. 로컬 자동화 테스트 사전 실행
echo "🧪 [Pre-Push Guard] 자동화 테스트 검증 중 (node test_v04.js)..."
if ! node test_v04.js > /dev/null 2>&1; then
    echo "🚨 [PUSH REJECTED] 자동화 테스트에 실패했습니다! 테스트를 통과한 후 push하세요."
    exit 1
fi

echo "✅ [Pre-Push Guard] 모든 사전 안전 검증을 통과했습니다. Push를 계속합니다."
exit 0
